datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String  @id @default(cuid())  
  email        String  @unique
  name         String?
  image        String?
  spotifyId    String? @unique 
  accessToken  String?  // Store user-specific access token  
  refreshToken String?  // Store refresh token for renewing access  
  expiresAt    DateTime  // Token expiry timestamp  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
